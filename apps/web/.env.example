# ============================================================================
# BuildRunner SaaS - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# OpenRouter API (Required for AI features)
# ----------------------------------------------------------------------------
# Get your key from: https://openrouter.ai/keys
# This can also be entered in the Settings page (http://localhost:3005/settings/api-keys)
OPENROUTER_API_KEY=your_openrouter_key_here

# ----------------------------------------------------------------------------
# Supabase Management API (Required for automatic project creation)
# ----------------------------------------------------------------------------
# Get your token from: https://app.supabase.com/account/tokens
# This allows BuildRunner to automatically create Supabase projects for users
# See SUPABASE_SETUP.md for detailed instructions
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token_here

# ----------------------------------------------------------------------------
# Next.js Configuration
# ----------------------------------------------------------------------------
# The base URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ----------------------------------------------------------------------------
# Optional: Additional AI Providers
# ----------------------------------------------------------------------------
# If you want to use other AI providers directly (not through OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here

# ----------------------------------------------------------------------------
# Optional: Database (If you want BuildRunner itself to use Supabase)
# ----------------------------------------------------------------------------
# Note: These are for BuildRunner's own database, NOT for user projects
# User projects get their own separate Supabase instances
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------------------------------------------
# Optional: Analytics & Monitoring
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn

# ----------------------------------------------------------------------------
# Optional: Stripe (For payments)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Set to "development" or "production"
NODE_ENV=development

# Enable debug logging (true/false)
# DEBUG=true

# ----------------------------------------------------------------------------
# Build Performance Optimization
# ----------------------------------------------------------------------------
# Enable persistent Claude CLI sessions for faster builds (experimental)
# When enabled, Claude sessions are reused across multiple tasks instead of
# spawning a new session for each task. This can reduce build time by ~10%
# (from 39min → ~35min for typical builds).
#
# Features:
# - Session pooling with warm standby for zero-downtime failover
# - Circuit breaker for automatic degradation on failures
# - Critical tasks (quality gates, tests) always use fresh sessions
# - Automatic fallback to per-task sessions if persistent sessions fail
#
# Safety:
# - Now ENABLED by default after validation (v1.2.0+)
# - Set to "false" if you experience session-related issues
# - Monitor logs for "♻️  Using persistent session" messages
# - If you see repeated session failures, disable this flag
#
# Performance impact:
# - Enabled:  ~35min builds (10% faster) ✅ RECOMMENDED
# - Disabled: ~39min builds (fallback mode)
#
ENABLE_PERSISTENT_SESSIONS=true

# ----------------------------------------------------------------------------
# Parallel Execution (Requires persistent sessions)
# ----------------------------------------------------------------------------
# Execute independent build tasks concurrently using wave-based dependency
# management. This can reduce build time by an additional 40% beyond
# persistent sessions (35min → ~20min for typical builds).
#
# Requirements:
# - ENABLE_PERSISTENT_SESSIONS must be set to "true"
# - Uses multiple Claude CLI sessions concurrently (4-6 sessions)
#
# Features:
# - Wave-based execution (groups tasks by dependency depth)
# - Automatic dependency validation before execution
# - Build state locking to prevent race conditions
# - Failed tasks automatically block dependent tasks
# - Quality gates remain sequential for safety
#
# Configuration:
# - MAX_PARALLEL_TASKS: Maximum number of concurrent tasks (default: 4)
#   - Recommended: 4 for most systems
#   - Maximum: 6 (higher values may hit API rate limits)
#   - Lower values (2-3) for slower machines or stricter rate limits
#
# Safety:
# - Now ENABLED by default after validation (v1.2.0+)
# - Set to "false" if you experience rate limit errors
# - Monitor for API rate limit errors in logs
# - Can be toggled at runtime (restart required)
#
# Performance impact (with persistent sessions enabled):
# - Parallel enabled:  ~20min builds (58% faster than baseline) ✅ RECOMMENDED
# - Parallel disabled: ~35min builds (27% faster than baseline)
# - Sequential only:   ~39min builds (fallback mode)
#
ENABLE_PARALLEL_EXECUTION=true
MAX_PARALLEL_TASKS=4

# ----------------------------------------------------------------------------
# PRD Orchestration Features (v1.2.0+)
# ----------------------------------------------------------------------------
# Enable automatic PRD watching and incremental rebuilds
# When enabled, changes to PRD.md trigger automatic task generation and execution
ENABLE_PRD_WATCHING=true

# Enable post-build PRD verification loop
# When enabled, Claude verifies build completeness against PRD after initial build
# and iteratively addresses gaps until requirements are met (max 5 iterations)
ENABLE_PRD_VERIFICATION=true
