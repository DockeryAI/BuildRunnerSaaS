# ============================================================================
# BuildRunner SaaS - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# OpenRouter API (Required for AI features)
# ----------------------------------------------------------------------------
# Get your key from: https://openrouter.ai/keys
# This can also be entered in the Settings page (http://localhost:3005/settings/api-keys)
OPENROUTER_API_KEY=your_openrouter_key_here

# ----------------------------------------------------------------------------
# Supabase Management API (Required for automatic project creation)
# ----------------------------------------------------------------------------
# Get your token from: https://app.supabase.com/account/tokens
# This allows BuildRunner to automatically create Supabase projects for users
# See SUPABASE_SETUP.md for detailed instructions
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token_here

# ----------------------------------------------------------------------------
# Next.js Configuration
# ----------------------------------------------------------------------------
# The base URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ----------------------------------------------------------------------------
# Optional: Additional AI Providers
# ----------------------------------------------------------------------------
# If you want to use other AI providers directly (not through OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here

# ----------------------------------------------------------------------------
# Optional: Database (If you want BuildRunner itself to use Supabase)
# ----------------------------------------------------------------------------
# Note: These are for BuildRunner's own database, NOT for user projects
# User projects get their own separate Supabase instances
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------------------------------------------
# Optional: Analytics & Monitoring
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn

# ----------------------------------------------------------------------------
# Optional: Stripe (For payments)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
# Set to "development" or "production"
NODE_ENV=development

# Enable debug logging (true/false)
# DEBUG=true
