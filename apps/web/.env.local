# BuildRunner SaaS - Environment Variables
# This file is gitignored and should never be committed

# OpenRouter API Key (for AI features)
# You can also set this via the Settings UI (localStorage)
OPENROUTER_API_KEY=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

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Development Settings
NODE_ENV=development

# ============================================================================
# Phase 1: Speed Optimization Variables
# ============================================================================

# Redis Cache (Upstash - optional but recommended for persistent caching)
# Sign up for free at https://upstash.com
# Leave empty to use memory-only caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pattern Matching (instant component generation from learned patterns)
PATTERN_MATCHING_ENABLED=true

# Multi-Layer Caching (Memory + Redis)
CACHE_ENABLED=true
CACHE_VERSION=1.0

# Smart Consensus (selective multi-LLM voting for critical components)
# DISABLED FOR SPEED - adds 5-15s per component
CONSENSUS_ENABLED=false
CONSENSUS_ASYNC=true

# Build Configuration
MAX_PARALLEL_BUILDS=5
